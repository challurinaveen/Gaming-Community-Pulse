# Copy to .env.local and fill in what you have.
# The three values in the first block are REQUIRED (every page sits behind sign-in).
# Everything else is optional: unconfigured platforms show clearly-labelled sample data,
# and unconfigured AI falls back to deterministic logic.

# --- Required for sign-in (accounts live in Supabase) ---
# SUPABASE_URL and SUPABASE_SECRET_KEY (the names used in the project report) also work.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string (32+ chars) used to sign session cookies, e.g. `openssl rand -base64 48`.
# Without it nobody can sign in (fail closed).
SESSION_SECRET=
# Optional: comma-separated email domains allowed to self-register, e.g. rs-group.com
ALLOWED_EMAIL_DOMAINS=

# --- AI ---
# Claude is used when ANTHROPIC_API_KEY is set; otherwise OpenAI stands in if OPENAI_API_KEY is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Platforms ---
# Comma-separated platforms to switch off entirely (not collected, no sample data, hidden), e.g. reddit
DISABLED_PLATFORMS=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username (without u/); Reddit rate-limits requests that don't identify the owner
REDDIT_USERNAME=

DISCORD_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
