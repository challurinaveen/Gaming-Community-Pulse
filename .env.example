# Blank template. NEVER put real values in this file: it is part of the source code and is published.
# Copy it to .env.local (which is never uploaded) and fill in the values there.
#
# These are the environment variables listed in the project report, Appendix A.
# Only the Supabase pair is required: every page sits behind sign-in, and the sign-in
# cookie key is derived from SUPABASE_SECRET_KEY. Every other source is optional and is
# replaced by clearly-labelled sample data when it is not configured.

# --- Storage and sign-in (required) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Platforms ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Optional extras (not in the report) ---
# Who may self-register: comma-separated domains and/or exact addresses,
# e.g. rs-group.com,someone@gmail.com (empty = anyone). Set this before going online.
ALLOWED_EMAIL_DOMAINS=
# Random string (32+ chars). On Vercel it lets the daily scheduled refresh (vercel.json) run.
CRON_SECRET=
# Your Reddit username (without u/); Reddit asks API clients to identify their owner
REDDIT_USERNAME=
# Comma-separated platforms to switch off entirely instead of showing sample data, e.g. reddit
DISABLED_PLATFORMS=
# Override the Gemini model (default gemini-3.8-flash)
# GEMINI_MODEL=
